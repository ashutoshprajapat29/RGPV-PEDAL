# ==========================================
# RGPV Bhopal Bicycle Rental Platform
# Environment Configuration Template
# ==========================================

# 1. Database Connection (SQLite default; can also be PostgreSQL if deployed on Supabase/Neon)
DATABASE_URL="file:./dev.db"

# 2. Secret Dedicated Fleet Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="rgpvadmin@2026"

# 3. WhatsApp Booking Receiver Phone Number
# (Indian 10-digit number; with or without 91 prefix)
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# 4. Campus Branding
NEXT_PUBLIC_CAMPUS_NAME="RGPV Bhopal"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# 5. Optional Cloudinary Storage (if deploying on serverless like Vercel instead of Docker/VPS)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
