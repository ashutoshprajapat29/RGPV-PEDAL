# 1. Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# 2. Secret Dedicated Fleet Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="rgpvadmin@2026"

# 3. WhatsApp Booking Receiver Phone Number
# (Indian 10-digit number; with or without 91 prefix)
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# 4. Campus Branding
NEXT_PUBLIC_CAMPUS_NAME="RGPV Bhopal"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# 5. Supabase Storage & API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
